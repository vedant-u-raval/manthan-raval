# Public URL of the website, without a trailing slash.
# On Vercel this can be left unset at first: the free *.vercel.app production URL is detected automatically.
# Set it once you know the final address (e.g. https://manthan-raval.vercel.app or a custom domain later).
NEXT_PUBLIC_SITE_URL=

# Google Search Console "HTML tag" verification code (only the content="..." value).
# Optional. Leave empty if you verify another way.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
